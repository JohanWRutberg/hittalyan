generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth ----------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Vilken bostadsförmedling användaren tillhör: stockholm | vast | syd | uppsala.
  // Väljs vid registrering, byts under Konto. Man ser en kö i taget.
  market String @default("stockholm")

  // Språk för gränssnitt, mail och push: "sv" eller "en"
  locale String @default("sv")

  // Plan: "free" eller "pro". Pro gäller till planExpiresAt (null = tills vidare).
  plan                     String    @default("free")
  planExpiresAt            DateTime?
  planSource               String?   // trial | stripe | admin
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?
  stripePriceId            String?

  // Better Auth admin-plugin
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions          Session[]
  accounts          Account[]
  queues            UserQueue[]
  watches           Watch[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Hitta Lyan ----------

/// Datum då användaren ställde sig i en viss kö (anges manuellt). Ett datum per
/// förmedling, så att det finns kvar om man byter kö och sedan byter tillbaka.
model UserQueue {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market       String
  registeredAt DateTime
  updatedAt    DateTime @updatedAt

  @@unique([userId, market])
  @@index([userId])
}

/// En annons hos någon av förmedlingarna. Id:t är "<marknad>:<id hos källan>",
/// eftersom förmedlingarna har var sin id-serie i olika format.
model Listing {
  id            String    @id
  market        String
  externalId    String
  apartmentId   Int?      // LägenhetId (bara Stockholm)
  projectId     Int?
  kommun        String
  stadsdel      String
  gatuadress    String
  vaning        Int?
  antalRum      Float?
  yta           Int?
  hyra          Int?
  annonseradFran DateTime?
  annonseradTill DateTime?
  lat           Float?
  lng           Float?
  url           String
  balkong       Boolean   @default(false)
  hiss          Boolean   @default(false)
  nyproduktion  Boolean   @default(false)
  ungdom        Boolean   @default(false)
  student       Boolean   @default(false)
  senior        Boolean   @default(false)
  korttid       Boolean   @default(false)
  vanlig        Boolean   @default(false)
  bostadssnabben Boolean  @default(false)
  koNamn        String?
  hyresvard     String?
  lagenhetstyp  String?
  /// Kötidens kvartiler för liknande lägenheter, i år (Stockholm)
  kotidQ1       Int?
  kotidQ3       Int?
  /// Genomsnittlig kötid i området senaste 12 månaderna, i år (Boplats Väst)
  kotidSnitt    Float?
  /// Antal sökande just nu (Boplats Väst, Boplats Syd, Uppsala)
  sokande       Int?

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  /// När annonsen senast hämtades i sin helhet. Källor som behöver ett anrop per
  /// annons använder den för att turas om att fräscha upp.
  refreshedAt   DateTime  @default(now())
  active        Boolean   @default(true)

  notifications Notification[]

  @@unique([market, externalId])
  @@index([market, kommun, stadsdel])
  @@index([market, active, firstSeenAt])
  @@index([firstSeenAt])
}

/// En bevakning = ett sparat filter som ska ge notiser
model Watch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean  @default(true)
  /// Vilken förmedling bevakningen gäller. Bevakningar fortsätter notifiera även
  /// om användaren byter kö, eftersom man kan stå i flera köer.
  market    String   @default("stockholm")

  kommuner   String[] @default([])
  stadsdelar String[] @default([])
  adress     String?  // fritext, matchar del av gatuadress (t.ex. "Grace")
  minRum     Float?
  maxRum     Float?
  minYta     Int?
  maxYta     Int?
  minHyra    Int?
  maxHyra    Int?
  minVaning  Int?
  maxVaning  Int?
  balkong    Boolean? // null = spelar ingen roll
  hiss       Boolean?
  nyproduktion Boolean?
  inkluderaUngdom  Boolean @default(false)
  inkluderaStudent Boolean @default(false)
  inkluderaSenior  Boolean @default(false)
  inkluderaKorttid Boolean @default(false)

  notifyEmail Boolean @default(true)
  notifyPush  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([userId])
  @@index([market])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Logg över skickade notiser, så samma annons inte skickas två gånger per bevakning
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchId   String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  emailSent Boolean  @default(false)
  pushSent  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([watchId, listingId])
  @@index([userId, createdAt])
}

/// Betalningshändelser från Stripe (idempotens + spårbarhet)
model StripeEvent {
  id         String   @id // Stripe event id
  type       String
  receivedAt DateTime @default(now())
}

model PollRun {
  id          String   @id @default(cuid())
  market      String   @default("stockholm")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  ok          Boolean  @default(false)
  total       Int      @default(0)
  newCount    Int      @default(0)
  notified    Int      @default(0)
  error       String?

  @@index([market, startedAt])
}
